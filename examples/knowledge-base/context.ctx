context "knowledge-base";
budget chars = 100;
output text;

section "answer-contract" priority = 100 required {
  text = "Answer from these local notes only.";
}

section "release-facts" priority = 80 {
  text = "MoonContext compiles context files deterministically.";
}

section "history" priority = 10 {
  text = "An early prototype explored remote imports, generated code, and several unrelated output formats.";
}
